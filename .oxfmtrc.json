{
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "endOfLine": "lf",
    "printWidth": 100,
    "proseWrap": "preserve",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false,
    "sortPackageJson": false,
    "overrides": [
        {
            "files": ["web/**/*.js", "site/**/*.js"],
            "options": {
                "embeddedLanguageFormatting": "off"
            }
        }
    ],
    "ignorePatterns": [
        "node_modules/",
        "data/",
        "docs-site/dist/",
        "docs-site/.astro/",
        "package-lock.json",
        "flake.lock",
        "*.png",
        "*.woff2"
    ]
}
